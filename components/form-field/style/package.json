{
  "version": "1.7.0",
  "author": "Community for NL Design System",
  "license": "CC0-1.0",
  "name": "@nl-rvo/css-form-field",
  "description": "Form field CSS component",
  "keywords": [
    "nl-design-system",
    "css",
    "form-field"
  ],
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/rvo.git",
    "directory": "components/form-field"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "exports": {
    ".": "./dist/form-field.css",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "sass --pkg-importer=node --style=compressed ./src/:./dist/",
    "watch": "sass --pkg-importer=node --style=compressed --watch ./src/:./dist/",
    "clean": "rimraf ./dist/"
  },
  "dependencies": {
    "@nl-rvo/css-layout-flow": "workspace:*"
  }
}
