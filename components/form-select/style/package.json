{
  "version": "1.6.0",
  "author": "Community for NL Design System",
  "license": "CC0-1.0",
  "name": "@nl-rvo/css-form-select",
  "description": "Form select CSS component",
  "keywords": [
    "nl-design-system",
    "css",
    "form-select"
  ],
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/rvo.git",
    "directory": "components/form-select/style"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "exports": {
    ".": {
      "style": "./dist/form-select.css",
      "import": "./dist/form-select.css",
      "default": "./dist/form-select.css"
    },
    "./form-select.css": "./dist/form-select.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "sass --pkg-importer=node --style=compressed ./src/:./dist/",
    "watch": "sass --pkg-importer=node --style=compressed --watch ./src/:./dist/",
    "clean": "rimraf ./dist/"
  },
  "dependencies": {
    "@utrecht/select-css": "2.0.1"
  }
}
