{
  "version": "1.6.0",
  "author": "Community for NL Design System",
  "license": "CC0-1.0",
  "name": "@nl-rvo/css-form-textarea",
  "description": "Form textarea CSS component",
  "keywords": [
    "nl-design-system",
    "css",
    "form-textarea"
  ],
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/rvo.git",
    "directory": "components/form-textarea/style"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "exports": {
    ".": {
      "style": "./dist/form-textarea.css",
      "import": "./dist/form-textarea.css",
      "default": "./dist/form-textarea.css"
    },
    "./form-textarea.css": "./dist/form-textarea.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "sass --pkg-importer=node --style=compressed ./src/:./dist/",
    "watch": "sass --pkg-importer=node --style=compressed --watch ./src/:./dist/",
    "clean": "rimraf ./dist/"
  },
  "dependencies": {
    "@nl-rvo/css-layout-flow": "workspace:*"
  }
}
