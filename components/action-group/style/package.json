{
  "version": "1.4.0",
  "author": "Community for NL Design System",
  "license": "CC0-1.0",
  "name": "@nl-rvo/css-action-group",
  "description": "Action group CSS component",
  "keywords": [
    "nl-design-system",
    "css",
    "action-group"
  ],
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/rvo.git",
    "directory": "components/action-group"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "exports": {
    ".": "./dist/action-group.css",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "sass --pkg-importer=node --style=compressed ./src/:./dist/",
    "watch": "sass --pkg-importer=node --style=compressed --watch ./src/:./dist/",
    "clean": "rimraf ./dist/"
  }
}
