{
  "version": "1.6.0",
  "author": "Community for NL Design System",
  "license": "CC0-1.0",
  "name": "@nl-rvo/css-layout-flow",
  "description": "Layout-flow CSS component",
  "keywords": [
    "nl-design-system",
    "css",
    "layout-flow"
  ],
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/rvo.git",
    "directory": "components/layout-flow/style"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "exports": {
    ".": {
      "style": "./dist/layout-flow.css",
      "import": "./dist/layout-flow.css",
      "default": "./dist/layout-flow.css"
    },
    "./layout-flow.css": "./dist/layout-flow.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "sass --pkg-importer=node --style=compressed ./src/:./dist/",
    "watch": "sass --pkg-importer=node --style=compressed --watch ./src/:./dist/",
    "clean": "rimraf ./dist/"
  }
}
