{
  "version": "0.4.0",
  "author": "Community for NL Design System",
  "license": "CC0-1.0",
  "name": "@nl-rvo/css-card-experimental",
  "description": "Card Experimental CSS component",
  "keywords": [
    "nl-design-system",
    "css",
    "card",
    "experimental"
  ],
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/rvo.git",
    "directory": "components/card-experimental/style"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "exports": {
    ".": {
      "style": "./dist/card-experimental.css",
      "import": "./dist/card-experimental.css",
      "default": "./dist/card-experimental.css"
    },
    "./card-experimental.css": "./dist/card-experimental.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "sass --pkg-importer=node --style=compressed ./src/:./dist/",
    "watch": "sass --pkg-importer=node --style=compressed --watch ./src/:./dist/",
    "clean": "rimraf ./dist/"
  },
  "devDependencies": {
    "@nl-rvo/build-utils-css": "workspace:*"
  }
}
