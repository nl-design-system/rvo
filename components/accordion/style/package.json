{
  "version": "1.3.1",
  "author": "Community for NL Design System",
  "license": "CC0-1.0",
  "name": "@nl-rvo/css-accordion",
  "description": "Accordion CSS component",
  "keywords": [
    "nl-design-system",
    "nl-rvo",
    "css",
    "accordion"
  ],
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/rvo.git",
    "directory": "components/accordion"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "exports": {
    ".": "./dist/accordion.css",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "sass --pkg-importer=node --style=compressed ./src/:./dist/",
    "watch": "sass --pkg-importer=node --style=compressed --watch ./src/:./dist/",
    "clean": "rimraf ./dist/"
  },
  "dependencies": {
    "@nl-rvo/css-layout-flow": "workspace:*",
    "@nl-rvo/css-link": "workspace:*"
  }
}
