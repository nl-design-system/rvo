{
  "version": "2.3.0",
  "author": "Community for NL Design System",
  "license": "CC0-1.0",
  "name": "@nl-rvo/css-heading",
  "description": "Heading CSS component",
  "keywords": [
    "nl-design-system",
    "nl-rvo",
    "css",
    "heading"
  ],
  "repository": {
    "type": "git+ssh",
    "url": "git@github.com:nl-design-system/rvo.git",
    "directory": "components/heading"
  },
  "files": [
    "src/",
    "dist/"
  ],
  "exports": {
    ".": "./dist/heading.css",
    "./dist/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "sass --pkg-importer=node --style=compressed ./src/:./dist/",
    "watch": "sass --pkg-importer=node --style=compressed --watch ./src/:./dist/",
    "clean": "rimraf ./dist/"
  },
  "dependencies": {
    "@utrecht/heading-1-css": "3.0.1",
    "@utrecht/heading-2-css": "3.0.1",
    "@utrecht/heading-3-css": "3.0.1",
    "@utrecht/heading-4-css": "3.0.1",
    "@utrecht/heading-5-css": "3.0.1",
    "@utrecht/heading-6-css": "3.0.1"
  }
}