{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "allowUnreachableCode": false,
    "declaration": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "es2015"],
    "module": "es2015",
    "moduleResolution": "node",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2015",
    "baseUrl": ".",
    "paths": {
      "tslib": ["node_modules/tslib/tslib.d.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../components/card/react/src/index.tsx",
    "../../components/breadcrumbs/react/src/index.tsx",
    "../../components/form-field-checkbox/react/src/index.tsx",
    "../../components/form-field-label/react/src/index.tsx",
    "../../components/form-feedback/react/src/index.tsx",
    "../../components/expandable-table/react/src/index.tsx",
    "../../components/form-checkbox-group/react/src/index.tsx"
    // "../../components/toggle/stories/toggle.stories.tsx",
    // "../../components/toggle/stories/toggle.states.stories.tsx",
    // "../../components/icon/react/src/Icon.tsx",
    // "../../components/icon/react/src/Icon.types.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
